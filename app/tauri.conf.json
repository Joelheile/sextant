{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sextant",
  "mainBinaryName": "sextant",
  "version": "0.1.0",
  "identifier": "app.sextant.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "26.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "frameworks": ["frameworks/libonnxruntime.dylib"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDNDU0NkU0MDY0ODY5RDcKUldUWGFVZ0c1RVpGUEQrNE11TVdad2l2R2hQcXBZK2xwSXkyUExYY3d5WER3VHRMeE9PZTg3NTUK",
      "endpoints": [
        "https://github.com/Joelheile/sextant/releases/latest/download/latest.json"
      ]
    }
  }
}
